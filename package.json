{
  "name": "oidn-webgpu",
  "version": "0.6.0",
  "description": "Open Image Denoise on WebGPU, in browsers and natively",
  "main": "lib/main.js",
  "types": "lib/main.d.ts",
  "files": [
    "lib",
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite dev",
    "watch": "vite build -w",
    "test": "npm run build:lib && npm run build && node --test tests/*.test.mjs",
    "test:leak": "node benchmarks/leak.mjs",
    "benchmark": "node benchmarks/compare.mjs",
    "model:inspect": "npm run build:lib && node scripts/inspect-model.mjs",
    "prepare": "npm run build:lib",
    "prepublishOnly": "npm run build && npm run build:lib",
    "build:lib": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc",
    "watch:lib": "tsc --watch",
    "native:build": "node scripts/native-build.mjs"
  },
  "author": "pissang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pissang/oidn-webgpu.git"
  },
  "homepage": "https://github.com/pissang/oidn-webgpu#readme",
  "license": "MIT",
  "dependencies": {
    "@petamoriken/float16": "^3.8.7"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.40",
    "playwright-core": "^1.62.1",
    "typescript": "^5.7.3",
    "vite": "^5.2.13",
    "vite-plugin-mkcert": "^1.17.5"
  }
}
